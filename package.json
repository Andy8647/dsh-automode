{
  "name": "@deepseek-ai/dsh-auto-approval",
  "description": "Automated tool-call approval for DeepSeek Harness: an `auto` tier for approval policy that classifies each tool call as allow / deny / ask before dispatch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-settings": "^0.0.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../../test-Andy8647/packages/core/agent",
    "@deepseek-ai/dsh-llm": "file:../../test-Andy8647/packages/llm/llm",
    "@deepseek-ai/dsh-session": "file:../../test-Andy8647/packages/core/session",
    "@deepseek-ai/dsh-settings": "file:../../test-Andy8647/packages/settings/settings",
    "@deepseek-ai/dsh-timeout": "file:../../test-Andy8647/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "file:../../test-Andy8647/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "file:../../test-Andy8647/packages/typert/protocol",
    "@types/node": "^26.1.2",
    "cordis": "^4.0.0-rc.7",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
