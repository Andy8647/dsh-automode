{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "strict": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib/types",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}
