{
  "name": "dsh-auto-approval",
  "description": "Automated tool-call approval for DeepSeek Harness: an `auto` tier for approval policy that classifies each tool call as allow / deny before dispatch",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andy8647/dsh-auto-approval.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.0",
    "@deepseek-ai/dsh-agent": ">=0.0.0",
    "@deepseek-ai/dsh-attachment": ">=0.0.0",
    "@deepseek-ai/dsh-brand": ">=0.0.0",
    "@deepseek-ai/dsh-code-runtime": ">=0.0.0",
    "@deepseek-ai/dsh-invariants": ">=0.0.0",
    "@deepseek-ai/dsh-llm": ">=0.0.0",
    "@deepseek-ai/dsh-scope": ">=0.0.0",
    "@deepseek-ai/dsh-session": ">=0.0.0",
    "@deepseek-ai/dsh-settings": ">=0.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.0",
    "@deepseek-ai/dsh-timeout": ">=0.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.0",
    "@deepseek-ai/dsh-user-approval": ">=0.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.4",
    "dsh-client-ui-auto-approval": "workspace:0.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-brand": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-code-runtime": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.0.1-rc.5",
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
